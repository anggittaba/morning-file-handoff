# Copy to .env (git-ignored). Every setting is optional.

# --- AI explanations (optional) -------------------------------------------
# Without a key, the rule-based explainer is used. Nothing is ever sent to a chat.
OPENAI_API_KEY=
GEMINI_API_KEY=
# auto | openai | gemini | off
HANDOFF_LLM=auto
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# --- Morning window --------------------------------------------------------
HANDOFF_START=06:00
HANDOFF_END=07:45
HANDOFF_DEADLINE=07:30
HANDOFF_INTERVAL_MIN=5
HANDOFF_AT_RISK_MIN=45

# --- Transfers -------------------------------------------------------------
HANDOFF_UPLOAD_ATTEMPTS=3
HANDOFF_RETRY_BACKOFF_S=0.5
HANDOFF_CONNECT_TIMEOUT_S=8
HANDOFF_CONCURRENCY=6

# --- Paths -----------------------------------------------------------------
# HANDOFF_VAR=var
# HANDOFF_DB=var/handoff.db
# HANDOFF_TOPOLOGY=config/topology.json
# HANDOFF_BRANCHES=config/branches.csv
# HANDOFF_CREDENTIALS=var/sim/credentials.json
# HANDOFF_KNOWN_HOSTS=var/sim/known_hosts

# Name shown in the audit log for dashboard actions
HANDOFF_OPERATOR=operator

# Passwords can also come from the environment, one per endpoint:
# HANDOFF_PASSWORD_<ENDPOINT>, upper case, dashes as underscores, e.g.
# HANDOFF_PASSWORD_DEST_BR01=...

# Freeze the clock (used for screenshots), e.g. 2026-10-08T06:50:00
# HANDOFF_NOW=
